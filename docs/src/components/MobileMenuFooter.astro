---
import { appFor, sponsor } from '../apps';

// The top bar has no room for these links on small screens, so the menu shows them.
const current = appFor(Astro.url.pathname);
---

<nav class="links" aria-label="Links">
	{current && <a href={`${current.github}/releases/latest`}>Download</a>}
	<a href={current?.github ?? 'https://github.com/juleshall4'}>GitHub</a>
	<a href={sponsor}>Sponsor</a>
</nav>

<style>
	.links {
		display: flex;
		gap: 1.75rem;
		/* Line up with the sidebar links above. */
		padding: 1rem 0.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.links a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
</style>
