---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import { appFor } from '../apps';

// Groups have a plain label, not a button: they never open or close.
const { sidebar } = Astro.locals.starlightRoute;
type Entry = (typeof sidebar)[number];
type Link = Extract<Entry, { type: 'link' }>;

// The config has one group for each app. Show only the pages of the app you're in.
const app = appFor(Astro.url.pathname);
const appGroup = sidebar.find((entry) => entry.type === 'group' && entry.label === app?.name);
const entries = appGroup?.type === 'group' ? appGroup.entries : [];

// Pages without a group, such as Get started, form one block at the top.
const blocks: { label?: string; links: Link[] }[] = [];
for (const entry of entries) {
	if (entry.type === 'group') {
		blocks.push({ label: entry.label, links: entry.entries.filter((e): e is Link => e.type === 'link') });
	} else if (blocks.at(-1)?.label === undefined && blocks.length) {
		blocks.at(-1)!.links.push(entry);
	} else {
		blocks.push({ links: [entry] });
	}
}
---

<nav class="atlas-sidebar" aria-label={app ? `${app.name} guide` : 'Guide'}>
	{
		blocks.map((block) => (
			<div class="block">
				{block.label && <p class="label">{block.label}</p>}
				<ul>
					{block.links.map((link) => (
						<li>
							<a href={link.href} aria-current={link.isCurrent ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		))
	}
</nav>

<div class="md:sl-hidden"><MobileMenuFooter /></div>

<style>
	.atlas-sidebar {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-top: 1.5rem;
	}
	.label {
		margin: 0 0 0.375rem;
		color: var(--sl-color-gray-2);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: 1.25rem;
		text-transform: uppercase;
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		padding: 0.375rem 0;
		color: var(--sl-color-gray-2);
		font-size: 1rem;
		line-height: 1.5rem;
		text-decoration: none;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	a[aria-current='page'] {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	/* Small screens: the menu matches the app's rows, with a bar beside the current page. */
	@media (max-width: 49.99rem) {
		.atlas-sidebar {
			gap: 1.5rem;
			padding-top: 0.5rem;
		}
		ul {
			gap: 0;
		}
		a {
			position: relative;
			padding: 0.625rem 0;
			color: var(--sl-color-white);
			font-size: 1.0625rem;
			font-weight: 500;
		}
		a[aria-current='page'] {
			font-weight: 600;
		}
		a[aria-current='page']::before {
			content: '';
			position: absolute;
			top: 50%;
			left: calc(-1 * var(--sl-sidebar-pad-x));
			width: 3px;
			height: 1.375rem;
			background: var(--sl-color-white);
			transform: translateY(-50%);
		}
	}
</style>
