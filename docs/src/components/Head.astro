---
import Default from '@astrojs/starlight/components/Head.astro';
import latin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import latinExt from '@fontsource-variable/inter/files/inter-latin-ext-opsz-normal.woff2?url';

// Inter is loaded here, not from Fontsource's CSS, so the main file can be preloaded.
// "fallback" shows the cached font straight away instead of swapping it in after the page draws.
const fontFace = (url: string, range: string) => `@font-face {
	font-family: 'Inter Variable';
	font-style: normal;
	font-display: fallback;
	font-weight: 100 900;
	src: url(${url}) format('woff2-variations');
	unicode-range: ${range};
}`;
const css = [
	fontFace(latinExt, 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'),
	fontFace(latin, 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'),
].join('\n');
---

<Default />
<link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />

<script>
	// "On this page" marks the last heading that has passed the top of the screen.
	// This replaces Starlight's tracking, which skips sections when scrolling up and
	// never reaches a short last section. At the end of the page the last section is
	// marked, or the section the reader just picked if its heading is already on screen.
	type Toc = HTMLElement & { current: HTMLAnchorElement };
	const setters = new Map<Toc, (link: HTMLAnchorElement) => void>();
	let picked: string | null = null;

	const update = () => {
		const end = document.documentElement;
		const atEnd = window.scrollY > 0 && window.scrollY + window.innerHeight >= end.scrollHeight - 2;
		const header = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
		const left = end.scrollHeight - window.scrollY - window.innerHeight;
		setters.forEach((set, toc) => {
			const links = [...toc.querySelectorAll('a')];
			const top = header + (toc.querySelector('summary')?.getBoundingClientRect().height ?? 0) + 32;
			// Over the last screen of scrolling, the line moves down the screen,
			// so short sections near the end are each marked in turn.
			const room = window.innerHeight - top - 48;
			const travel = Math.min(room, end.scrollHeight - window.innerHeight);
			const line = top + (travel > 0 ? Math.max(0, Math.min(1, 1 - left / travel)) : 0) * room;
			let link = links[0];
			for (const a of links) {
				const heading = document.getElementById(decodeURIComponent(a.hash.slice(1)));
				if (heading && heading.getBoundingClientRect().top <= line) link = a;
			}
			if (atEnd) link = links.find((a) => a.hash === picked) ?? links.at(-1) ?? link;
			if (link) set(link);
		});
	};

	let frame = 0;
	const schedule = () => {
		cancelAnimationFrame(frame);
		frame = requestAnimationFrame(update);
	};

	// Take over each table of contents: keep its setter, and ignore Starlight's own updates.
	const take = (toc: Toc) => {
		let proto = Object.getPrototypeOf(toc);
		while (proto && !Object.getOwnPropertyDescriptor(proto, 'current')) proto = Object.getPrototypeOf(proto);
		const set = proto && Object.getOwnPropertyDescriptor(proto, 'current')?.set;
		if (!set) return;
		setters.set(toc, (link) => set.call(toc, link));
		Object.defineProperty(toc, 'current', { set() {}, configurable: true });
	};
	for (const name of ['starlight-toc', 'mobile-starlight-toc']) {
		customElements.whenDefined(name).then(() => {
			document.querySelectorAll<Toc>(name).forEach(take);
			schedule();
		});
	}

	document.addEventListener('click', (event) => {
		const link = (event.target as Element).closest<HTMLAnchorElement>(':is(starlight-toc, mobile-starlight-toc) a');
		if (!link) return;
		picked = link.hash;
		schedule();
	});
	for (const type of ['wheel', 'touchstart', 'keydown']) {
		window.addEventListener(type, () => (picked = null), { passive: true });
	}
	window.addEventListener('scroll', schedule, { passive: true });
	window.addEventListener('resize', schedule);
</script>
