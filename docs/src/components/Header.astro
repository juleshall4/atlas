---
import Search from 'virtual:starlight/components/Search';
import { apps, appFor, sponsor } from '../apps';

// Download and GitHub point to the app you're in, so the home page has neither.
const current = appFor(Astro.url.pathname);
---

<div class="header">
	<div class="left">
		<a class="brand" href="/">Julian Hall</a>
		<nav class="apps" aria-label="Apps">
			{
				apps.map((app) => (
					<a href={`/${app.id}/`} aria-current={app === current ? 'page' : undefined}>
						{app.name}
					</a>
				))
			}
		</nav>
	</div>
	<div class="right">
		<nav class="links" aria-label="Links">
			<a class="sponsor" href={sponsor}>
				<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
					<path
						d="M8 13.5S2 10 2 6a3 3 0 0 1 6-1 3 3 0 0 1 6 1c0 4-6 7.5-6 7.5z"
						fill="currentColor"
						fill-opacity="0"
						stroke="currentColor"
						stroke-width="1.4"
						stroke-linejoin="round"></path>
				</svg>
				Sponsor
			</a>
			{current && <a href={`${current.github}/releases/latest`}>Download</a>}
			<a href={current?.github ?? 'https://github.com/juleshall4'}>GitHub</a>
		</nav>
		<Search />
	</div>
</div>

<style>
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sl-nav-gap);
		height: 100%;
	}
	.left {
		display: flex;
		align-items: stretch;
		gap: 2.5rem;
		height: 100%;
		min-width: 0;
	}
	.brand {
		display: flex;
		align-items: center;
		color: #ffffff;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	/* The app tabs: the current app is white with a line under it, along the bottom of the bar */
	.apps {
		display: flex;
		gap: 1.75rem;
	}
	.apps a {
		display: flex;
		align-items: center;
		padding-top: 2px;
		border-bottom: 2px solid transparent;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.apps a:hover {
		color: #ffffff;
	}
	.apps a[aria-current='page'] {
		border-bottom-color: #ffffff;
		color: #ffffff;
		font-weight: 500;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}
	.links {
		display: none;
		align-items: center;
		gap: 1.75rem;
	}
	.links a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.links a:hover {
		color: #ffffff;
	}
	.links .sponsor {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.25rem;
		padding: 0 0.875rem 0 0.75rem;
		border: 1px solid #2c2c2e;
		color: #ffffff;
		font-size: 0.9375rem;
		font-weight: 500;
	}
	.links .sponsor svg {
		transition: color 0.3s ease;
	}
	.links .sponsor path {
		transition: fill-opacity 0.3s ease;
	}
	.links .sponsor:hover {
		border-color: #5a5a5e;
	}
	.links .sponsor:hover svg {
		color: #ff375f;
	}
	.links .sponsor:hover path {
		fill-opacity: 1;
	}
	@media (min-width: 50rem) {
		.links {
			display: flex;
		}
	}
	/* Small screens: the app tabs still fit, at a smaller size */
	@media (max-width: 49.99rem) {
		.left {
			gap: 1.25rem;
		}
		.brand {
			font-size: 1.125rem;
		}
		.apps {
			gap: 1rem;
			font-size: 0.9375rem;
		}
	}
</style>
