{
	// The guide is a static site: Cloudflare serves the files in dist/ with no Worker code.
	// Deploy with `bun run build && bunx wrangler deploy`.
	"name": "atlas",
	"compatibility_date": "2026-11-10",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "apps.julian-hall.com", "custom_domain": true },
		// The old address serves the same site, and _redirects sends old page links to their new place.
		{ "pattern": "atlas.julian-hall.com", "custom_domain": true }
	]
}
