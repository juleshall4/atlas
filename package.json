{
  "name": "atlas",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "../ink/scripts/ink dev",
    "build": "../ink/scripts/ink build",
    "check": "bun run typecheck && bun test tools/checks && bun run notes",
    "check:phone": "bash tools/checks/about.sh && bash tools/checks/feedback.sh && python3 tools/checks/preview-focus.py",
    "notes": "bun tools/checks/release-notes.ts",
    "typecheck": "tsc --noEmit",
    "release": "bash tools/release.sh",
    "debug": "bash tools/debug.sh"
  },
  "dependencies": {
    "ink": "file:../ink/packages/ink",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
